{
  "name": "googleai-desktop",
  "version": "0.1.0",
  "description": "GoogleAI — Giao diện desktop Tiếng Việt cho Google Antigravity chính thức",
  "main": "./out/main/index.js",
  "author": "GoogleAI VN",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-installer.ps1"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.1.0",
    "agent-desktop": "^1.3.1",
    "docx": "^9.16.0",
    "i18next": "^24.2.3",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "agent-desktop",
      "electron",
      "esbuild"
    ]
  }
}
